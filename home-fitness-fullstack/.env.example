# FitCoach 本地 docker compose 环境变量样例
# 复制为 .env 并填上你自己的 key

AI_COACH_PROVIDER=mock
MIMO_API_KEY=
AI_TTS_PROVIDER=browser
AI_MEMORY_ENABLED=true

# —— JoyAI-VL 视觉推理（可选，需 GPU + Linux）—— #
# 留空时 vision-svc 走占位推理。启用步骤：
#   1) docker compose --profile joyai up -d joyai-vl    # 拉起自托管 vLLM（约 16GB 权重）
#   2) 设 JOYAI_VL_BASE_URL 指向它，重建 vision-svc
# 也可指向任意外部 OpenAI 兼容的 JoyAI-VL 端点（远程 GPU 机器等）。
JOYAI_VL_BASE_URL=
JOYAI_VL_MODEL=joyai-vl
JOYAI_VL_API_KEY=
JOYAI_VL_TIMEOUT=25
# 自托管时拉取的 HF 模型仓库（默认京东开源预览版）
JOYAI_VL_HF_MODEL=jdopensource/JoyAI-VL-Interaction-Preview
# 私有 / 受限模型需要 HF token
HUGGING_FACE_HUB_TOKEN=
