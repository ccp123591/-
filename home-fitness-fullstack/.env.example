# FitCoach 本地 docker compose 环境变量样例
# 复制为 .env 并填上你自己的 key

# 可选：宿主机端口（本地已占用时可换端口）
FRONTEND_PORT=5173
BACKEND_PORT=8080
VISION_PORT=8081
REDIS_PORT=6379
MYSQL_PORT=3306

# 生产模式（使用 docker-compose.prod.yml 时必填）
# SPRING_PROFILES_ACTIVE 由生产 override 文件固定为 prod，无需手动设置。
DB_NAME=fitcoach
DB_USER=fitcoach
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_INIT_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true

# —— MiMo AI 教练 / TTS —— #
# tp- 开头的 key 只在 token-plan-cn 网关有效，官方 api.xiaomimimo.com 会返回 401。
# v2.5 上线后旧模型名（mimo-v2-flash / mimo-v2-tts）与音色 default_zh 均已下线。
AI_COACH_PROVIDER=mock
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
AI_TTS_PROVIDER=browser
MIMO_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
# 可选音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
MIMO_TTS_VOICE=mimo_default
AI_MEMORY_ENABLED=true

# —— JoyAI-VL 视觉推理（可选，模型只部署在远程 GPU 服务器）—— #
# 留空时 vision-svc 走占位推理。启用时将 BASE_URL 指向远程/托管的
# OpenAI 兼容端点；本机 docker compose 不会启动 JoyAI-VL。
JOYAI_VL_BASE_URL=
JOYAI_VL_MODEL=joyai-vl
JOYAI_VL_API_KEY=
JOYAI_VL_TIMEOUT=25
